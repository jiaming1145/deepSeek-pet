{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    // §1.2/C1: @ds/sim and @ds/behaviors carry explicit `.ts` extensions on every relative import,
    // and this program compiles their sources (pet/main.ts and stage/arbiter.ts import both). The
    // main program (tsconfig.json) already sets the same flag for the same reason. apps/desktop's
    // own files keep the extensionless convention — the flag only permits, it never requires.
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    // Mirrors packages/stage/tsconfig.json: the vendored Cubism Framework src is compiled as part of
    // this program (reached through @framework/*), and it needs these three relaxations to build.
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": { "@framework/*": ["../../vendor/CubismWebFramework/src/*"] }
  },
  // "tests" lives in THIS program, not the main one: stage.spec.ts imports the ?test=1 hook type
  // from src/renderer/pet/main.ts, which drags in @ds/stage and the vendored Framework - only this
  // config has the @framework path mapping, the DOM lib and the three relaxations they need.
  "include": ["src/renderer/pet", "tests", "../../vendor/core/live2dcubismcore.d.ts", "../../packages/stage/src"],
  // …with three exceptions, all main-side: §12.7's motion/arbiter fixtures construct
  // `WindowMotionController`, which drags src/main (and app-protocol.ts) into whichever program
  // compiles them. Under this config's `strictNullChecks: false` app-protocol.ts's discriminated
  // union stops narrowing and TS2339 fires on code no Phase 3 task owns. They are compiled by
  // tsconfig.json (the main program) instead, where they type-check clean.
  //
  // Named BY FILE, not by directory (fix round 1, finding 6): tests/fixtures/motion and
  // tests/fixtures/arbiter are also where a RENDERER-side fixture would naturally live, and a
  // directory rule would silently hand it to the main program. The rule for later tasks:
  // everything under tests/** belongs to the renderer program unless it is named in both of these
  // lists — a main-side fixture adds one line here and one line in tsconfig.json.
  "exclude": [
    "tests/fixtures/motion/stale-generation.fixture.ts",
    "tests/fixtures/motion/display-unplug.fixture.ts",
    "tests/fixtures/arbiter/renderer-reload.fixture.ts"
  ]
}
