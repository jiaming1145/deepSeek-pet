    { "id": "memory-05", "category": "memory", "text": "我妹妹叫什么", "priorTurns": [{ "role": "user", "content": "我妹妹叫小满，比我小六岁" }, { "role": "assistant", "content": "小满，好名字。" }], "axes": ["memory_use"], "note": "事实=小满" },
